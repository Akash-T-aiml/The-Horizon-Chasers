# Traffix Backend Configuration
APP_NAME=Traffix
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (defaults to SQLite fallback if Postgres not provided)
DATABASE_URL=sqlite:///./traffix.db

# Provider settings
TRAFFIC_PROVIDER=demo
WEATHER_PROVIDER=demo
EVENTS_PROVIDER=demo
ROUTING_PROVIDER=demo

# Demo Seed configuration
DEMO_ORIGIN=KPR Institute
DEMO_DESTINATION=Coimbatore Railway Station
