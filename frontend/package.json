{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:backend": "cd ../backend && python -m uvicorn app.main:app --port 8000 --reload",
    "dev:all": "concurrently --kill-others-on-fail --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"npm run dev:backend\""
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
